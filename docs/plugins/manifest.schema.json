  "$id": "manifest.schema.json",
  "title": "Arkenda extension manifest (arkenda-plugin.json), schema version 2",
  "description": "Generated by scripts/plugin-schema.ts from the app validator (PLUGIN_MANIFEST_SCHEMA, read by parsePluginManifestV2); do not edit by hand.",
  "type": "object",
  "if": {
    "anyOf": [
      {
        "not": {
          "required": [
            "kind"
          ]
        }
      },
      {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "plugin"
          }
        }
      }
    ]
  },
