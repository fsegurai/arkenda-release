      "id": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      },
      "name": {
        "type": "string",
        "maxLength": 80,
        "pattern": "\\S"
      },
      "version": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
      },
      "apiVersion": {
        "type": "integer",
        "minimum": 1,
        "description": "The plugin API version (this app: 1)."
