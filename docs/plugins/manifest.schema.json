      "id",
      "name",
      "version",
      "apiVersion",
      "minAppVersion",
      "description",
      "author",
      "publisher",
      "license",
      "repository",
      "categories",
      "platforms",
      "permissions",
      "contributes",
      "entry",
      "integrity"
