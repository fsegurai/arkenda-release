{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Arkenda extension manifest (arkenda-plugin.json), schema version 2",
  "description": "Generated by scripts/plugin-manifest-schema.ts from the app validator (parsePluginManifestV2); do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "apiVersion",
    "minAppVersion",
    "description",
    "author",
    "publisher",
    "license",
    "repository",
    "categories",
    "platforms"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "description": "What the extension is; \"plugin\" when left out. Only \"plugin\" runs code. An unknown kind is shown as \"other\" and never run.",
      "default": "plugin",
      "anyOf": [
        {
          "enum": [
            "plugin",
            "theme",
            "font",
            "icon-pack",
            "snippet-pack",
            "language-pack"
          ]
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "maxLength": 80,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "apiVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "The plugin API version (this app: 1)."
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        }
      }
    },
    "publisher": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "license": {
      "type": "string",
      "maxLength": 128,
      "description": "An SPDX license expression (MIT, Apache-2.0 OR MIT)."
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "enum": [
              "editing",
              "writing",
              "markdown",
              "tables",
              "footnotes",
              "code",
              "emoji",
              "annotation",
              "properties",
              "files",
              "folders",
              "tags",
              "links",
              "navigation",
              "search",
              "tasks",
              "dates",
              "images",
              "attachments",
              "pdf",
              "music",
              "visualization",
              "graph",
              "integrations",
              "syncing",
              "import",
              "publishing",
              "research",
              "automation",
              "ai",
              "interface",
              "sidebar",
              "status-bar",
              "commands",
              "fonts",
              "utilities"
            ],
            "description": "A category of the governed taxonomy."
          },
          {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
            "description": "Any other id is accepted and shown as \"other\"."
          }
        ]
      },
      "minItems": 1,
      "maxItems": 3
    },
    "keywords": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 32,
        "pattern": "\\S"
      },
      "maxItems": 10
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "desktop",
          "mobile"
        ]
      },
      "minItems": 1
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "notes:read",
          "notes:write",
          "storage",
          "commands",
          "ui:panels",
          "ui:widgets",
          "markdown",
          "network",
          "clipboard",
          "notifications",
          "ui:themes",
          "editor",
          "sync"
        ]
      }
    },
    "optionalPermissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "notes:read",
          "notes:write",
          "storage",
          "commands",
          "ui:panels",
          "ui:widgets",
          "markdown",
          "network",
          "clipboard",
          "notifications",
          "ui:themes",
          "editor",
          "sync"
        ]
      },
      "description": "Permissions of `permissions` the plugin works without."
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts"
      ],
      "description": "Only with the \"network\" permission.",
      "properties": {
        "hosts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "description": "An exact public host name (api.example.com): no wildcard, address or port."
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 80,
                "pattern": "\\S"
              },
              "hotkey": {
                "type": "string",
                "description": "The default key, e.g. Mod-Shift-k; bound only when free."
              }
            }
          }
        },
        "markdownFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 80,
                "pattern": "\\S"
              }
            }
          }
        },
        "sidebarPanels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 80,
                "pattern": "\\S"
              },
              "icon": {
                "enum": [
                  "note",
                  "pin",
                  "search",
                  "dashboard",
                  "notebook",
                  "tag",
                  "command",
                  "panel-outline",
                  "panel-backlinks",
                  "panel-properties",
                  "panel-hotkeys",
                  "panel-widgets"
                ]
              },
              "places": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "left",
                    "right",
                    "status"
                  ]
                },
                "minItems": 1
              },
              "defaultPlace": {
                "enum": [
                  "left",
                  "right",
                  "status"
                ],
                "description": "One of the declared places (by default: dashboard for widgets, left for panels)."
              }
            }
          }
        },
        "dashboardWidgets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 80,
                "pattern": "\\S"
              },
              "category": {
                "enum": [
                  "notes",
                  "tasks",
                  "time",
                  "focus",
                  "insights",
                  "other"
                ]
              },
              "places": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "dashboard",
                    "aside"
                  ]
                },
                "minItems": 1
              },
              "defaultPlace": {
                "enum": [
                  "dashboard",
                  "aside"
                ],
                "description": "One of the declared places (by default: dashboard for widgets, left for panels)."
              }
            }
          }
        },
        "settingsTabs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 80,
                "pattern": "\\S"
              }
            }
          }
        },
        "themes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 64,
                "pattern": "\\S"
              }
            }
          }
        },
        "insertItems": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 64,
                "pattern": "\\S"
              }
            }
          }
        },
        "toolbarItems": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 64,
                "pattern": "\\S"
              }
            }
          }
        },
        "syncSources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
              },
              "title": {
                "type": "string",
                "maxLength": 80,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "entry": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.m?js$",
      "description": "The bundle, relative to the package root."
    },
    "integrity": {
      "type": "string",
      "pattern": "^sha256-[A-Za-z0-9+/]{43}=$",
      "description": "SHA-256 of the bundle bytes."
    }
  },
  "if": {
    "anyOf": [
      {
        "not": {
          "required": [
            "kind"
          ]
        }
      },
      {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "plugin"
          }
        }
      }
    ]
  },
  "then": {
    "required": [
      "permissions",
      "contributes",
      "entry",
      "integrity"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "permissions"
          ]
        },
        {
          "required": [
            "contributes"
          ]
        },
        {
          "required": [
            "entry"
          ]
        },
        {
          "required": [
            "integrity"
          ]
        },
        {
          "required": [
            "optionalPermissions"
          ]
        },
        {
          "required": [
            "network"
          ]
        }
      ]
    }
  },
  "x-taxonomy": {
    "families": [
      "writing",
      "organizing",
      "media",
      "seeing",
      "connecting",
      "automating",
      "appearance",
      "utilities"
    ],
    "categories": [
      {
        "id": "editing",
        "family": "writing"
      },
      {
        "id": "writing",
        "family": "writing"
      },
      {
        "id": "markdown",
        "family": "writing"
      },
      {
        "id": "tables",
        "family": "writing"
      },
      {
        "id": "footnotes",
        "family": "writing"
      },
      {
        "id": "code",
        "family": "writing"
      },
      {
        "id": "emoji",
        "family": "writing"
      },
      {
        "id": "annotation",
        "family": "writing"
      },
      {
        "id": "properties",
        "family": "writing"
      },
      {
        "id": "files",
        "family": "organizing"
      },
      {
        "id": "folders",
        "family": "organizing"
      },
      {
        "id": "tags",
        "family": "organizing"
      },
      {
        "id": "links",
        "family": "organizing"
      },
      {
        "id": "navigation",
        "family": "organizing"
      },
      {
        "id": "search",
        "family": "organizing"
      },
      {
        "id": "tasks",
        "family": "organizing"
      },
      {
        "id": "dates",
        "family": "organizing"
      },
      {
        "id": "images",
        "family": "media"
      },
      {
        "id": "attachments",
        "family": "media"
      },
      {
        "id": "pdf",
        "family": "media"
      },
      {
        "id": "music",
        "family": "media"
      },
      {
        "id": "visualization",
        "family": "seeing"
      },
      {
        "id": "graph",
        "family": "seeing"
      },
      {
        "id": "integrations",
        "family": "connecting"
      },
      {
        "id": "syncing",
        "family": "connecting"
      },
      {
        "id": "import",
        "family": "connecting"
      },
      {
        "id": "publishing",
        "family": "connecting"
      },
      {
        "id": "research",
        "family": "connecting"
      },
      {
        "id": "automation",
        "family": "automating"
      },
      {
        "id": "ai",
        "family": "automating"
      },
      {
        "id": "interface",
        "family": "appearance"
      },
      {
        "id": "sidebar",
        "family": "appearance"
      },
      {
        "id": "status-bar",
        "family": "appearance"
      },
      {
        "id": "commands",
        "family": "appearance"
      },
      {
        "id": "fonts",
        "family": "appearance"
      },
      {
        "id": "utilities",
        "family": "utilities"
      }
    ],
    "unknown": "other"
  }
}
